NODE_ENV=development
PORT=4000

# Supabase: Project -> Connect -> Session pooler URI (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase requires SSL; set to false only for a local Postgres without SSL
DATABASE_SSL=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Default passwords used by `npm run db:seed`
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123

# Groq (https://console.groq.com/keys). Leave empty to run with keyword classification only.
GROQ_API_KEY=
# Optional model overrides
# GROQ_CLASSIFY_MODEL=openai/gpt-oss-20b
# GROQ_DRAFT_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# GROQ_TIMEOUT_MS=15000
